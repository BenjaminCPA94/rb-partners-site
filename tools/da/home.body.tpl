<script>
(() => {
  // Anchors of the previous homepage, still linked from other pages
  const OLD = { 'v4-booking': 'contact', 'v2-founders': 'cabinet', equipe: 'cabinet', 'v4-why': 'expertises', expertises: 'expertises', accompagnement: 'expertises', international: 'international', 'v2-international': 'international', 'v2-faq': 'contact', associes: 'cabinet', missions: 'expertises', aud: 'expertises', intl: 'international', guides: 'ressources', faq: 'contact' };
  const remap = () => { const w = OLD[location.hash.slice(1)]; if (w) location.replace('#' + w); };
  remap(); addEventListener('hashchange', remap);
  document.getElementById('year').textContent = new Date().getFullYear();
  // mobile menu
  const top = document.querySelector('.top'), burger = document.querySelector('.burger');
  const close = () => { top.classList.remove('is-open'); burger.setAttribute('aria-expanded', 'false'); };
  burger.addEventListener('click', () => { const o = top.classList.toggle('is-open'); burger.setAttribute('aria-expanded', String(o)); });
  document.querySelectorAll('#nav a').forEach(a => a.addEventListener('click', close));
  addEventListener('keydown', e => { if (e.key === 'Escape') { close(); burger.focus(); } });
  // reveal on scroll
  const els = document.querySelectorAll('.rv');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) els.forEach(e => e.classList.add('in'));
  else { const io = new IntersectionObserver(es => es.forEach(x => { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }), { threshold: .12 }); els.forEach(e => io.observe(e)); }
})();
</script>
